# ── Seguridad ─────────────────────────────────────────────────────────────────
# Generá una clave con: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=django-insecure-change-this-in-production
DJANGO_DEBUG=False

ALLOWED_HOSTS=localhost 127.0.0.1 crm.supregsolutions.com
CSRF_TRUSTED_ORIGINS=https://crm.supregsolutions.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=crm_obra_social
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Evolution API (WhatsApp via QR) ──────────────────────────────────────────
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=tu_api_key_segura
EVOLUTION_INSTANCE_NAME=crm-supreg
# Token que Evolution API incluye en el header "apikey" al hacer POST al webhook del CRM
EVOLUTION_WEBHOOK_TOKEN=token_secreto_para_validar_webhooks
# URL pública de Evolution API (para el generador de QR en el panel)
EVOLUTION_SERVER_URL=http://localhost:8080

# ── n8n / bots externos ───────────────────────────────────────────────────────
# URL del webhook de n8n para reenviarle los mensajes entrantes de WhatsApp (vacío = desactivado)
N8N_WEBHOOK_URL=
# API key que n8n y bots usan para autenticarse contra /whatsapp/api/handoff/, /whatsapp/api/bot/
# y el endpoint de actualización de contactos de la API de integración (vacío = endpoints desactivados)
CRM_API_KEY=

# ── Proxy residencial ─────────────────────────────────────────────────────────
# Necesario si el VPS tiene IP de datacenter bloqueada por WhatsApp
PROXY_HOST=
PROXY_PORT=
PROXY_PROTOCOL=http
PROXY_USERNAME=
PROXY_PASSWORD=

# ── Email (producción) ────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu@email.com
EMAIL_HOST_PASSWORD=
